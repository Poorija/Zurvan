# Zurvan desktop container optimized for High-Res and Dynamic Resizing
# Build: docker compose -f docker-compose.novnc.yml build

FROM golang:1.25-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DISPLAY=:1 \
    QT_X11_NO_MITSHM=1 \
    XDG_RUNTIME_DIR=/tmp/runtime-zurvan \
    NOVNC_PORT=6080 \
    VNC_PORT=5900 \
    PYTHONPATH=/opt/zurvan \
    ZURVAN_HOME=/opt/zurvan \
    LIBGL_ALWAYS_SOFTWARE=1 

WORKDIR /opt/zurvan

RUN apt-get update && apt-get install -y --no-install-recommends \
    tigervnc-standalone-server \
    tigervnc-tools \
    novnc \
    websockify \
    openbox \
    xauth \
    xvfb \
    x11-xserver-utils \
    xterm \
    aircrack-ng \
    build-essential \
    ca-certificates \
    curl \
    dbus-x11 \
    dnsrecon \
    dnsutils \
    ffuf \
    fonts-dejavu \
    fonts-liberation \
    git \
    gobuster \
    hashcat \
    hydra \
    iproute2 \
    iputils-ping \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcairo2-dev \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libegl1 \
    libffi-dev \
    libgbm1 \
    libglib2.0-0 \
    libgl1 \
    libgtk-3-0 \
    libjpeg-dev \
    libnss3 \
    libpcap-dev \
    libssl-dev \
    libxcb-cursor0 \
    libxcb-glx0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-shm0 \
    libxcb-sync1 \
    libxcb-xfixes0 \
    libxcb-xinerama0 \
    libxcb-xkb1 \
    libxkbcommon-x11-0 \
    libxml2-dev \
    libxslt1-dev \
    pkg-config \
    python-is-python3 \
    python3 \
    python3-dev \
    python3-pip \
    python3-pyqt6 \
    python3-pyqt6.qtwebengine \
    python3-venv \
    tini \
    wget \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/zurvan-requirements.txt
RUN grep -Ev '^(PyQt6|PyQt6-WebEngine)$' /tmp/zurvan-requirements.txt > /tmp/zurvan-requirements-docker.txt \
    && python3 -m pip install --break-system-packages --upgrade pip setuptools wheel \
    && python3 -m pip install --break-system-packages -r /tmp/zurvan-requirements-docker.txt \
    && python3 -m pip install --break-system-packages dirsearch maigret sherlock-project sqlmap

RUN set -eux; \
    export GOBIN=/usr/local/bin; \
    go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest || true; \
    go install github.com/projectdiscovery/httpx/cmd/httpx@latest || true; \
    go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest || true; \
    go install github.com/projectdiscovery/naabu/v2/cmd/naabu@latest || true; \
    go install github.com/projectdiscovery/katana/cmd/katana@latest || true; \
    go install github.com/trufflesecurity/trufflehog/v3@latest || true; \
    go clean -cache -modcache || true

COPY . /opt/zurvan
RUN mkdir -p "${XDG_RUNTIME_DIR}" /opt/zurvan/data /opt/zurvan/reports /opt/zurvan/artifacts \
    && chmod 700 "${XDG_RUNTIME_DIR}" \
    && chmod +x /opt/zurvan/docker/novnc/entrypoint.sh /opt/zurvan/docker/novnc/launch-zurvan.sh \
    && find /opt/zurvan/tools -type f \( -name "*.sh" -o -name "*.py" \) -exec chmod +x {} \; || true

EXPOSE 6080 5900

ENTRYPOINT ["/usr/bin/tini", "--", "/opt/zurvan/docker/novnc/entrypoint.sh"]