#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HARVESTER_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
REPO_ROOT="$(cd "${HARVESTER_ROOT}/../.." && pwd)"
PYTHON_BIN="${REPO_ROOT}/.venv/bin/python"
VENV_HARVESTER="${REPO_ROOT}/.venv/bin/theHarvester"

export PYTHONPATH="${HARVESTER_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
if [[ -x "${VENV_HARVESTER}" ]]; then
  exec "${VENV_HARVESTER}" "$@"
fi

if [[ ! -x "${PYTHON_BIN}" ]]; then
  PYTHON_BIN="$(command -v python3)"
fi

exec "${PYTHON_BIN}" -c 'import asyncio; from theHarvester.__main__ import entry_point; asyncio.run(entry_point())' "$@"
